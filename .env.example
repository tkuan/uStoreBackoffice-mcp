# ---- Target API ------------------------------------------------------------
USTORE_BASE_URL=https://produproduce.mysite.com/ustorebackofficerestapi

# This deployment serves OAS3 at /ustore-oas3, not the usual /swagger/* paths
# (those all 404), so the spec URL must be set explicitly.
USTORE_SPEC_URL=https://produproduce.mysite.com/ustorebackofficerestapi/ustore-oas3

# ---- TLS -------------------------------------------------------------------
# Internal cert not in the system trust store? Prefer pinning the CA over
# disabling verification.
# USTORE_CA_FILE=/etc/ssl/certs/mysite-internal-ca.pem
# USTORE_TLS_INSECURE=false

# ---- Auth ------------------------------------------------------------------
# mode: login | bearer | apikey | basic | none
USTORE_AUTH_MODE=login
USTORE_USERNAME=
USTORE_PASSWORD=

# Confirm these with `npm run probe` — defaults are a guess.
USTORE_LOGIN_PATH=/v1/admin/auth/login
USTORE_LOGIN_BODY={"email":"{{username}}","password":"{{password}}"}
USTORE_TOKEN_PATH=Token,token,access_token
USTORE_AUTH_HEADER=Authorization
USTORE_AUTH_SCHEME=uStoreBackoffice
# Force a re-login every N seconds; 0 = only refresh after a 401.
USTORE_TOKEN_TTL_SECONDS=0

# For a static key instead:
# USTORE_AUTH_MODE=apikey
# USTORE_TOKEN=xxxxx
# USTORE_AUTH_HEADER=Authorization
# USTORE_AUTH_SCHEME=uStoreBackoffice

# ---- Safety ----------------------------------------------------------------
# Read-only by default, matching the AFDS/GAMS MCP servers.
USTORE_ALLOW_WRITES=false
USTORE_DENY_PATHS=/delete,/purge,/reset,/uninstall
# USTORE_ALLOW_PATHS=^/api/(Orders|Stores|Products|Users)

# ---- Limits ----------------------------------------------------------------
USTORE_TIMEOUT_MS=60000
USTORE_MAX_RESPONSE_CHARS=60000
USTORE_SPEC_REFRESH_MS=900000

# ---- MCP transport ---------------------------------------------------------
# stdio for Claude Desktop on the same box; http for the HAProxy/SSE stack.
MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=8931
# Optional shared secret enforced on /mcp and /sse.
# MCP_BEARER_TOKEN=
